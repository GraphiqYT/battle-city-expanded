{
  "name": "battle-city-expanded-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Offline desktop wrapper for Battle City Expanded",
  "author": "GraphiqYT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare:game": "node prepare-game.cjs",
    "build:win": "npm run prepare:game && electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.graphiqyt.battlecityexpanded",
    "productName": "Battle City Expanded",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "staging/game",
        "to": "game"
      }
    ],
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
